# Gemini API key — get yours free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default AI model (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: server timezone for date calculations (default: Asia/Kolkata)
# All "today" computations (reminders, /leads/due-today, AI prompt date) use this timezone.
# This is critical if your server runs on UTC — without it, reminders will be off by 5h30m.
# Examples: Asia/Kolkata, UTC, America/New_York, Europe/London
# TIMEZONE=Asia/Kolkata
